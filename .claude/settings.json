{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ALPHA_ENV": "dev"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr create*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(uv run mypy*)",
      "Bash(uv run pre-commit*)",
      "Bash(uv sync*)",
      "Bash(uv run python scripts/*)",
      "Bash(uv run alpha backtest*)",
      "Bash(uv run alpha status*)",
      "Bash(uv run alpha paper*)",
      "Bash(uv run alpha reconcile*)",
      "Bash(lemma query run*)",
      "Bash(lemma records get*)",
      "Bash(lemma files search*)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(npx --yes markdownlint-cli2*)",
      "Bash(npx --yes cspell*)"
    ],
    "deny": [
      "Bash(*ALPHA_ALLOW_LIVE*)",
      "Bash(*ALPHA_ENV=live*)",
      "Bash(*alpha run*--adapter*kite*)",
      "Bash(*alpha run*--adapter*delta*)",
      "Bash(*alpha run*--adapter*binance*)",
      "Bash(*alpha run*--adapter*bybit*)",
      "Bash(*alpha run*--adapter*dhan*)",
      "Bash(*alpha run*--adapter*upstox*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f *)",
      "Bash(git push*--force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git clean -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-touched.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "printf '%s | ALPHA_ENV=%s' \"$(git branch --show-current 2>/dev/null || echo no-branch)\" \"${ALPHA_ENV:-dev}\""
  }
}
