<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd LaunchAgent for the Mac → box Lemma token relay (token-persistence, deploy/relay).
     Runs lemma_token_relay.sh every 3 min (StartInterval=180) so the box .env always holds a token
     minted within ~3 min; the box worker re-reads it (token_refresh_seconds) and swaps clients
     without a restart. Paths are absolute for THIS Mac (the operator's), like the systemd units are
     for the box. Install/verify/remove: see deploy/relay/README.md. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alpha.lemma-token-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jaydipdas/Code/Alpha/deploy/relay/lemma_token_relay.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>180</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/jaydipdas/Library/Logs/alpha-lemma-token-relay.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jaydipdas/Library/Logs/alpha-lemma-token-relay.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
