{
  // RLS (per-user). The daily Kite token RELAY only — `access_token` +
  // `token_refreshed_at`; the API *secret* never lives in the pod (it stays on
  // the worker). enable_rls:true -> each user owns their token row.
  "name": "broker_credentials",
  "primary_key_column": "id",
  "enable_rls": true,
  "columns": [
    { "name": "venue", "type": "TEXT", "required": true, "max_length": 16 },
    { "name": "access_token", "type": "TEXT", "max_length": 512,
      "description": "daily relayed token (NOT the API secret)" },
    { "name": "token_refreshed_at", "type": "DATETIME" }
  ]
}
