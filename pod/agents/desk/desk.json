{
  "name": "desk",
  "description": "Alpha mission-control copilot — answers operator questions about the discovery → backtest → paper → live pipeline from the pod tables + the /knowledge corpus. Read-only: never trades, never moves money, never surfaces the holdout (TEST-8 / TEST-3).",
  "instruction": { "$file": "instruction.md" },
  // toolsets: POD SKILLS SPEECH SUBAGENTS TODO USER_INTERACTION WEB_SEARCH WORKSPACE_CLI
  "toolsets": ["POD"],
  "visibility": "POD",   // PERSONAL | POD | PUBLIC | RESTRICTED
  // Pin desk to the Claude Code daemon harness on Opus (the operator's standing pref) instead of the
  // cloud system:lemma default (minimax-m3). NB: this makes desk daemon-dependent — if `lemma daemon`
  // is down, runs fail (Lemma has no daemon->cloud fallback); keep the daemon running (ideally on the box).
  "agent_runtime": { "profile_id": "019ef088-83ea-730f-b282-8ef4fec8c1ce", "model_name": "opus" },
